# Copy to .env.local for local development (never commit .env.local).
# Both Supabase values are PUBLIC by design: access is enforced by Row Level
# Security and server-side database functions. This app never needs the
# service-role key — do not add it here or to Vercel.

# Supabase project URL.
#   Local:      http://127.0.0.1:54321  (printed by `npx supabase start`)
#   Production: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
#   Local:      PUBLISHABLE_KEY (or ANON_KEY) printed by `npx supabase status`
#   Production: Supabase dashboard → Project Settings → API Keys → anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Show "Continue with Google" on the sign-in page. Only set to true after
# enabling the Google provider in Supabase (Authentication → Providers).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
